{
  "id": "/",
  "name": "Bosun",
  "short_name": "Bosun",
  "description": "Send software work to AI agents on machines you own.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a1220",
  "theme_color": "#0a1220",
  "icons": [
    { "src": "/ui/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/ui/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New session", "url": "/?open=new", "icons": [{ "src": "/ui/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Projects", "url": "/?open=projects", "icons": [{ "src": "/ui/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
